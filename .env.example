# ---------------------------------------------------------------------------
# CloudCommerce support agent configuration
# Copy to .env and adjust.  Everything has a safe local default.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# LLM provider: groq | deterministic
# `deterministic` is a rule-based offline fallback so the demo and tests run
# without any API key.  Production should use `groq`.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# Embedding provider: huggingface | hashing
# `huggingface` runs sentence-transformers locally (free, no API key).
# `hashing` is a dependency-light deterministic fallback for CI/offline tests.
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_DEVICE=cpu

# RAG
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.15

# Business policy
RETURN_WINDOW_DAYS=14
REFUND_APPROVAL_THRESHOLD=100.0
# Fixed "today" for reproducible demos/tests, ISO date. Empty = system date.
REFERENCE_DATE=

# Storage
DATABASE_PATH=data/agent.sqlite3
TOOL_LOG_PATH=logs/tool_calls.jsonl

# Orders service resilience
ORDERS_SIMULATE_FAILURE=          # timeout | error | "" (empty = disabled)
ORDERS_TIMEOUT_SECONDS=2.0
ORDERS_MAX_RETRIES=2
