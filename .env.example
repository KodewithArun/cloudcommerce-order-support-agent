# ---------------------------------------------------------------------------
# CloudCommerce support agent configuration
# Copy to .env and adjust.  Everything has a safe local default.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# ── LLM provider: groq (default) | openai | anthropic ────────────────
LLM_PROVIDER=groq

# Groq  (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI  (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic  (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Shared LLM tuning
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# ── Embedding provider: huggingface (default) | openai | fake ────────
EMBEDDING_PROVIDER=huggingface

# HuggingFace sentence-transformers (runs locally, no API key needed)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_DEVICE=cpu

# OpenAI embeddings (uses OPENAI_API_KEY above)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Fake / deterministic embeddings (for CI / offline tests)
FAKE_EMBEDDING_SIZE=384

# ── RAG ───────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.15

# ── Business policy ──────────────────────────────────────────────────
RETURN_WINDOW_DAYS=14
REFUND_APPROVAL_THRESHOLD=100.0
# Fixed "today" for reproducible demos/tests, ISO date. Empty = system date.
REFERENCE_DATE=

# ── Storage ───────────────────────────────────────────────────────────
DATABASE_PATH=data/agent.sqlite3
TOOL_LOG_PATH=logs/tool_calls.jsonl

# ── Orders service resilience ─────────────────────────────────────────
ORDERS_SIMULATE_FAILURE=          # timeout | error | "" (empty = disabled)
ORDERS_TIMEOUT_SECONDS=2.0
ORDERS_MAX_RETRIES=2
